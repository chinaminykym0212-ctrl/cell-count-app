* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: 'Segoe UI', sans-serif;
  background: #f3f4f6;
  color: #111827;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 280px;
  background: #111827;
  color: white;
  padding: 18px;
  overflow-y: auto;
}

.sidebar .panel-block,
.summary-panel .panel-block {
  background: rgba(255,255,255,0.04);
  border-radius: 14px;
  padding: 14px;
  margin-bottom: 16px;
}

.sidebar h2,
.sidebar h3,
.summary-panel h3 {
  margin-top: 0;
  margin-bottom: 12px;
}

.sidebar button,
.topbar button,
.primary {
  border: none;
  border-radius: 10px;
  padding: 10px 12px;
  margin: 6px 0;
  background: #1f2937;
  color: white;
  width: 100%;
  text-align: left;
}

.sidebar .list-item.active,
.tool.active {
  background: linear-gradient(135deg, #2563eb, #3b82f6);
}

.workspace {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 16px;
  gap: 16px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  background: white;
  padding: 12px 16px;
  border-radius: 16px;
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
}

.tool-header,
.export-box {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tool {
  background: #e5e7eb;
  color: #111827;
  width: auto;
  text-align: center;
  min-width: 110px;
}

.tool.erase {
  background: #fee2e2;
  color: #991b1b;
}

.export-box button {
  width: auto;
  background: #e5e7eb;
  color: #111827;
}

.canvas-panel {
  background: white;
  border-radius: 18px;
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
  padding: 14px;
}

.image-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.image-title-row input {
  flex: 1;
  border: 1px solid #d1d5db;
  background: #f9fafb;
  border-radius: 10px;
  padding: 10px 12px;
}

.upload-box {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #d1d5db;
  background: #f9fafb;
  border-radius: 10px;
  padding: 10px 12px;
  cursor: pointer;
}

.upload-box input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

.image-stage {
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  min-height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-stage svg {
  width: 100%;
  max-width: 1100px;
  aspect-ratio: 16 / 10;
  background: linear-gradient(135deg, #f8fafc, #edf2f7);
  border-radius: 12px;
  touch-action: none;
}

.empty-stage {
  padding: 60px 20px;
  color: #6b7280;
  font-size: 1.05rem;
}

.summary-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(260px, 1fr));
  gap: 16px;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(100px, 1fr));
  gap: 12px;
}

.stat-box {
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-box span {
  color: #6b7280;
  font-size: 0.82rem;
}

.stat-box strong {
  font-size: 1.4rem;
}

.config-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.config-item {
  display: flex;
  gap: 8px;
  align-items: center;
  justify-content: space-between;
  background: #f9fafb;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 10px;
}

.config-item label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
}

.config-item input[type='text'] {
  border: 1px solid #d1d5db;
  border-radius: 8px;
  padding: 8px 10px;
}

.swatch-box {
  width: 70px;
}

.swatch-box input[type='color'] {
  width: 100%;
  height: 38px;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  background: transparent;
}

@media (max-width: 980px) {
  .app-shell {
    flex-direction: column;
  }

  .sidebar {
    width: 100%;
  }

  .summary-panel {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: stretch;
  }
}

@media (max-width: 640px) {
  .workspace {
    padding: 10px;
  }

  .tool-header,
  .export-box {
    display: grid;
    grid-template-columns: repeat(2, minmax(120px, 1fr));
  }

  .tool {
    width: 100%;
  }
}

